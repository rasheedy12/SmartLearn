# OAuth callback URL must exactly match the redirect URI registered with each provider.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth_callback.php
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
OAUTH_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
OAUTH_MICROSOFT_TENANT_ID=common

# Optional. Keep Paystack credentials on the server and out of source control.
PAYSTACK_SECRET_KEY=your-paystack-test-secret
PAYSTACK_CALLBACK_URL=https://your-public-domain.example.com/pages/paystack_callback.php
APP_ENV=local
